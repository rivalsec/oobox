# oobox configuration — copy to deploy/.env and edit. All values are read by
# Config.from_env(); `python -m oobox check` prints the effective config.

# --- identity (REQUIRED) ---------------------------------------------------
# The zone this box is authoritative for. Its NS records must be delegated here.
OOBDOMAIN=oob.example.com
# This box's PUBLIC IP(s) — what the wildcard A/AAAA ANSWERS with (what targets connect to).
# Behind 1:1 NAT / a floating IP this is the PUBLIC IP, even though the interface has a
# private one — put the private/interface IP in OOB_BIND below, not here.
OOB_IPV4=203.0.113.10
#OOB_IPV6=2001:db8::10
# Nameserver hostnames advertised at the apex (default: ns1/ns2.<domain>).
#OOB_NS=ns1.oob.example.com ns2.oob.example.com
#OOB_SOA_MAIL=hostmaster.oob.example.com

# --- control API auth (REQUIRED) -------------------------------------------
# Bearer key for the control API. Generate with:  python -m oobox genkey
OOB_API_KEY=CHANGE_ME_run_python_-m_oobox_genkey
# IP/CIDR allowlist for the control API (space/comma separated). STRONGLY recommended —
# empty means any IP with the key may call it. Loopback (127.0.0.1/::1) is ALWAYS allowed,
# so you never add it here: the certbot hooks and SSH-tunnelled dashboard keep working.
# List only your remote admin IP(s)/CIDR(s):
#OOB_API_ALLOW=10.0.0.0/8 203.0.113.0/24

# --- TLS (free Let's Encrypt wildcard *.OOBDOMAIN + apex) ------------------
# Get one with deploy/get-cert.sh (DNS-01, self-answered). On bare-metal/systemd oobox
# AUTO-DETECTS /etc/letsencrypt/live/<OOBDOMAIN>/ — just restart, no need to set these.
# Set them only for a custom path or in Docker (mount the cert into the container).
#OOB_TLS_CERT=/certs/live/oob.example.com/fullchain.pem
#OOB_TLS_KEY=/certs/live/oob.example.com/privkey.pem
# Disable the auto-detect of the standard Let's Encrypt path:
#OOB_TLS_AUTODETECT=false
# Optional separate cert for the control API (defaults to the ones above).
#OOB_API_TLS_CERT=
#OOB_API_TLS_KEY=

# --- listeners (defaults shown) --------------------------------------------
#OOB_DNS_PORT=53
#OOB_HTTP_PORT=80
#OOB_HTTPS_PORT=443
#OOB_SMTP_PORT=25
#OOB_API_PORT=8443
# Bind address(es) for DNS/HTTP/SMTP — the LOCAL interface IP oobox LISTENS on. Behind
# 1:1 NAT / a floating IP, bind the interface's private IP (e.g. 10.0.0.6) or 0.0.0.0 — you
# CANNOT bind the public IP (it's not on a local interface). If port 53 is already held by
# systemd-resolved (127.0.0.53:53), binding the interface IP also sidesteps that collision.
# You can list SEVERAL (space/comma-separated) to serve on multiple IPs — e.g. a two-
# nameserver delegation where the registrar wants distinct NS IPs: OOB_BIND="203.0.113.10 203.0.113.11"
# (or an IPv4 + IPv6: OOB_BIND="203.0.113.10 2001:db8::10").
#OOB_BIND=0.0.0.0
# Bind the control API to a management interface in production, e.g. 127.0.0.1
# (reach it over an SSH tunnel or WireGuard) or a private VPC IP.
#OOB_API_BIND=0.0.0.0

# --- storage / retention ---------------------------------------------------
#OOB_DB=/data/oobox.db
#OOB_FILES_DIR=/data/hosted
#OOB_TTL_DAYS=7
#OOB_MAX_UPLOAD=5242880
#OOB_MAX_CAPTURE=2097152
#OOB_MAX_SCREENSHOT=6291456   # cap on a blind-XSS screenshot dataURL POST

# --- behaviour -------------------------------------------------------------
#OOB_DNS_TTL=60
# Token length: random base36 chars after the "ob" prefix (default 8; clamped 4..32).
# Any length in that range is recognised, so changing it won't orphan existing tokens.
# Shorter = tidier payloads; longer = harder to guess. Per-token override: POST /register {"len":N}.
#OOB_TOKEN_LEN=8

# Outbound SMTP send (the dashboard "Send mail" + POST /send). OFF by default.
# Mail is sent FROM <token>@OOBDOMAIN so replies loop back to the catch-all.
#OOB_SMTP_SEND=true
# Delivery path: a smarthost relay is the reliable option (direct-to-MX from a VPS is
# best-effort — outbound :25 is often blocked and receivers weigh SPF/DKIM/PTR).
#OOB_SMTP_RELAY=smtp.your-relay.tld:587
#OOB_SMTP_RELAY_USER=apikey
#OOB_SMTP_RELAY_PASS=secret
#OOB_SMTP_RELAY_STARTTLS=true
# Resolver used for outbound MX lookups when no relay is set.
#OOB_RESOLVER=1.1.1.1

# --- Telegram alerts (optional) --------------------------------------------
# On when both token + chat are set. Create a bot with @BotFather; get the chat id
# from @userinfobot (or a group's id, which is negative).
#OOB_TG_TOKEN=123456:AA...bottoken
#OOB_TG_CHAT=-1001234567890
# Coalesce bursts: all hits within this many seconds → ONE summary message.
#OOB_ALERT_WINDOW=5
# Which capture kinds alert (default: all incoming). e.g. only the high-signal ones:
#OOB_ALERT_KINDS=mail,xss
# Optional proxy (where api.telegram.org is blocked). http(s):// works out of the box;
# socks5:// needs `pip install aiohttp_socks`.
#OOB_TG_PROXY=socks5://127.0.0.1:9050
# Or point at a self-hosted / reverse-proxied Bot API instead of a proxy:
#OOB_TG_API_BASE=https://api.telegram.org
